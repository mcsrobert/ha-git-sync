#!/bin/bash
# git-sync's exechook. git-sync runs it in the new worktree after every sync and when it starts,
# and retries it with backoff until it succeeds. It links the checkout into /config, installs the
# integrations and cards CI built, and reloads Home Assistant, or restarts it when integrations changed.
set -euo pipefail

config=/config
current=.git-sync/current
state=$config/.git-sync/state
ha_url=${HA_URL:-http://localhost:8123}
token_file=${HA_TOKEN_FILE:-/etc/git-secret/ha-token}
commit=${GITSYNC_HASH:?}

mkdir -p "$state"

record() {
  printf '%s\n' "$2" > "$state/.$1"
  mv "$state/.$1" "$state/$1"
}

recorded() {
  cat "$state/$1" 2> /dev/null || true
}

# Print the HTTP status of a call to Home Assistant's API, or why there is none: down when nothing answers at
# $ha_url, closed when Home Assistant closed the connection without answering, and failed for other errors.
api() {
  local result
  result=$(curl --silent --show-error --max-time 120 --output "$state/response" \
    --write-out '%{http_code} %{exitcode}' \
    --header @<(printf 'Authorization: Bearer %s\n' "$(< "$token_file")") \
    --header 'Content-Type: application/json' "${@:2}" "$ha_url/api/$1") || true
  case ${result#* } in
    0) echo "${result% *}" ;;
    6 | 7) echo down ;;
    52 | 56) echo closed ;;
    *) echo failed ;;
  esac
}

# Exit, so git-sync retries the hook later, unless Home Assistant answered and accepted the token.
answered() {
  case $1 in
    down | closed | failed)
      echo "Home Assistant is not reachable at $ha_url ($1); retrying later" >&2
      exit 1
      ;;
    401 | 403)
      echo "Home Assistant rejected the token (HTTP $1)" >&2
      exit 1
      ;;
  esac
}

json() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/}
  value=${value//$'\t'/ }
  printf '"%s"' "$value"
}

notify() {
  local status
  status=$(api services/persistent_notification/create --data \
    "{\"notification_id\": \"git_sync_$1\", \"title\": $(json "$2"), \"message\": $(json "$3")}")
  if [[ $status != 200 ]]; then
    echo "Creating notification $1 failed with HTTP $status" >&2
    return 1
  fi
}

aside() {
  local backup=$1.pre-git
  if [[ -e $backup || -L $backup ]]; then
    backup=$1.pre-git.$(date +%Y%m%d%H%M%S)
  fi
  if ! mv "$1" "$backup"; then
    echo "Cannot move $1 aside; give this container write access to ${1%/*}, or move it yourself" >&2
    exit 1
  fi
  echo "Moved $1 to $backup"
}

# Link each top-level entry of the checkout into /config, except hidden ones and the folders install fills.
link() {
  local entry
  for entry in *; do
    if [[ ! -e $entry || $entry == custom_components || $entry == www ]]; then
      continue
    fi
    if [[ -L $config/$entry && $(readlink "$config/$entry") == "$current/$entry" ]]; then
      continue
    fi
    if [[ -e $config/$entry || -L $config/$entry ]]; then
      aside "$config/$entry"
    fi
    ln -s "$current/$entry" "$config/$entry"
    echo "Linked $entry"
  done
  for entry in "$config"/*; do
    if [[ -L $entry && $(readlink "$entry") == "$current/${entry##*/}" && ! -e ${entry##*/} ]]; then
      rm "$entry"
      echo "Removed the link ${entry##*/}"
    fi
  done
}

# Make $1 a folder only this hook writes; its .git-sync marker records what it installed.
own() {
  if [[ -f $1/.git-sync ]]; then
    return
  fi
  if [[ -e $1 || -L $1 ]]; then
    aside "$1"
  fi
  mkdir "$1"
  : > "$1/.git-sync"
}

# Replace everything in $2 with the folders of $1 in this commit, unless its marker shows they are installed.
install() {
  local source=$1 target=$2 want have entry name
  want=$(git rev-parse --verify --quiet "$commit:$source" || true)
  have=$(cat "$target/.git-sync")
  if [[ $want == "$have" ]]; then
    return
  fi
  for entry in "$target"/* "$target"/.[!.]*; do
    name=${entry##*/}
    if [[ -e $entry && $name != .git-sync && ($name == .* || ! -d $source/$name) ]]; then
      rm -rf "$entry"
    fi
  done
  for entry in "$source"/*/; do
    [[ -d $entry ]] || continue
    name=$(basename "$entry")
    cp -R "$source/$name" "$target/.$name.new"
    if [[ -e $target/$name ]]; then
      mv "$target/$name" "$target/.$name.old"
    fi
    mv "$target/.$name.new" "$target/$name"
    rm -rf "$target/.$name.old"
  done
  printf '%s\n' "$want" > "$target/.git-sync.new"
  mv "$target/.git-sync.new" "$target/.git-sync"
  echo "Installed $source from ${commit:0:7}"
}

built_from=$(git log -1 --format='%(trailers:key=Source-Commit,valueonly)' "$commit" | head -n 1)
if [[ -z $built_from ]]; then
  echo "${commit:0:7} has no Source-Commit trailer, so CI did not build it; not installing or reloading"
  record installed "$commit"
  if [[ $(recorded reloaded) != "$commit" ]]; then
    notify deploy "Configuration not deployed" "The deployed branch is at ${commit:0:7}, which CI did not \
build, so nothing was installed or reloaded. The next CI run on the main branch restores it."
    record reloaded "$commit"
  fi
  exit 0
fi

if [[ -z $(recorded installed) ]]; then
  for name in automations.yaml scripts.yaml scenes.yaml; do
    if [[ -f $config/$name && ! -L $config/$name ]]; then
      aside "$config/$name"
    fi
  done
fi
link
if [[ ! -d $config/www ]]; then
  mkdir -m 2775 "$config/www"
fi
own "$config/custom_components"
own "$config/www/community"
integrations=$(cat "$config/custom_components/.git-sync")
install custom_components "$config/custom_components"
install www/community "$config/www/community"
# Home Assistant loads integrations only when it starts, so replacing installed ones needs a restart.
if [[ -n $integrations && $(cat "$config/custom_components/.git-sync") != "$integrations" ]]; then
  record restart "$built_from"
fi
record installed "$commit"

if [[ $(recorded reloaded) != "$commit" ]]; then
  status=$(api config)
  answered "$status"
  if [[ $status != 200 ]]; then
    echo "Home Assistant answered HTTP $status; retrying later" >&2
    exit 1
  fi
  if ! grep -q '"state": *"RUNNING"' "$state/response"; then
    echo "Home Assistant is still starting; retrying later" >&2
    exit 1
  fi
  if [[ -s $state/restart ]]; then
    status=$(api services/homeassistant/restart --data '{}')
    # Home Assistant may stop before it answers.
    if [[ $status == closed ]]; then
      status=200
    fi
    answered "$status"
    if [[ $status == 200 ]]; then
      echo "Restarting Home Assistant with ${built_from:0:7}, because integrations changed"
      rm "$state/restart"
    else
      notify restart "Home Assistant not restarted" "Restarting with ${built_from:0:7} failed with HTTP \
$status, so Home Assistant runs the old integrations until the next deploy restarts it: \
$(head -c 1000 "$state/response")"
    fi
  else
    status=$(api services/homeassistant/reload_all --data '{}')
    answered "$status"
    if [[ $status == 200 ]]; then
      echo "Reloaded Home Assistant with ${built_from:0:7}"
    else
      notify reload "Configuration not reloaded" \
        "Reloading ${built_from:0:7} failed with HTTP $status: $(head -c 1000 "$state/response")"
    fi
  fi
  record reloaded "$commit"
fi

orphans=()
for name in automations.yaml scripts.yaml scenes.yaml; do
  if [[ -f $config/$name && ! -L $config/$name ]]; then
    orphans+=("$name")
  fi
done
if ((${#orphans[@]})); then
  notify editor "Changes made in the UI are not loaded" "Home Assistant saved ${orphans[*]} in /config, \
but it loads its configuration from Git. Move the changes to the configuration repository and delete \
the files."
fi
