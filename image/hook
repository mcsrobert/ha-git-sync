#!/bin/bash
# git-sync's exechook. git-sync runs it in the new worktree after every sync and when it starts,
# and retries it with backoff until it succeeds. It links the checkout into /config, installs the
# integrations and cards CI built, and reloads Home Assistant, or restarts it when integrations changed.
set -euo pipefail
export LC_ALL=C

config=/config
current=.git-sync/current
state=$config/.git-sync/state
ha_url=${HA_URL:-http://localhost:8123}
token_file=${HA_TOKEN_FILE:-/etc/git-secret/ha-token}
commit=${GITSYNC_HASH:?}
editor_files=(automations.yaml scripts.yaml scenes.yaml)

mkdir -p "$state/notifications" "$state/trees"

die() {
  echo "$1" >&2
  exit 1
}

write_atomic() {
  local path=$1 name=${1##*/} tmp
  tmp=${path%/*}/.${name#.}.tmp
  shift
  printf '%s\n' "$@" > "$tmp"
  mv "$tmp" "$path"
}

record() {
  write_atomic "$state/$1" "${@:2}"
}

recorded() {
  cat "$state/$1" 2> /dev/null || true
}

# Print the HTTP status of a call to Home Assistant's API, or why there is none: down when nothing answers at
# $ha_url, closed when Home Assistant closed the connection without answering, and failed for other errors.
api() {
  local result code exitcode
  result=$(curl --silent --show-error --max-time 120 --output "$state/response" \
    --write-out '%{http_code} %{exitcode}' \
    --header @<(printf 'Authorization: Bearer %s\n' "$(< "$token_file")") \
    --header 'Content-Type: application/json' "${@:2}" "$ha_url/api/$1") || true
  code=${result% *}
  exitcode=${result#* }
  if [[ $1 == services/homeassistant/restart && $code == [45][0-9][0-9] && $exitcode != 0 ]]; then
    printf '%s' 'The error response was interrupted.' > "$state/response"
    echo "$code"
    return
  fi
  case $exitcode in
    0) echo "$code" ;;
    6 | 7) echo down ;;
    52 | 56) echo closed ;;
    *) echo failed ;;
  esac
}

# Exit, so git-sync retries the hook later, unless Home Assistant answered and accepted the token.
answered() {
  case $1 in
    down | closed | failed) die "Home Assistant is not reachable at $ha_url ($1); retrying later" ;;
    401 | 403) die "Home Assistant rejected the token (HTTP $1)" ;;
  esac
}

json() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/}
  value=${value//$'\t'/ }
  value=${value//[$'\001'-$'\037']/}
  printf '"%s"' "$value"
}

# Home Assistant's last answer, cut to 1000 bytes without ending in part of a character.
excerpt() {
  local text
  if (($(wc -c < "$state/response") > 1000)); then
    # Keep the lookahead byte even when it is a newline, then remove the character containing it.
    text=$(head -c 1001 "$state/response" | tr '\000' ' '; printf .)
    text=${text%.}
    while [[ $text == *[$'\x80'-$'\xbf'] ]]; do
      text=${text%?}
    done
    text=${text%?}
  else
    text=$(cat "$state/response")
  fi
  printf '%s' "$text"
}

# Queue a persistent notification. Queued, a failed delivery is retried without repeating what the hook did.
notify() {
  write_atomic "$state/notifications/$1" \
    "{\"notification_id\": \"git_sync_$1\", \"title\": $(json "$2"), \"message\": $(json "$3")}"
}

send_notifications() {
  local file status
  for file in "$state/notifications"/*; do
    [[ -f $file ]] || continue
    status=$(api services/persistent_notification/create --data-binary @"$file")
    answered "$status"
    case $status in
      408 | 429 | 5[0-9][0-9])
        echo "Creating notification ${file##*/} failed with HTTP $status; retrying later" >&2
        return 1
        ;;
    esac
    if [[ $status != 200 ]]; then
      echo "Home Assistant rejected the notification ${file##*/} (HTTP $status): $(excerpt)" >&2
    fi
    rm "$file"
  done
}

aside() {
  local backup=$1.pre-git
  if [[ -e $backup || -L $backup ]]; then
    backup=$1.pre-git.$(date +%Y%m%d%H%M%S)
  fi
  mv "$1" "$backup" || die "Cannot move $1 aside; give this container write access to ${1%/*}, or move it yourself"
  echo "Moved $1 to $backup"
}

# Link each top-level entry of the checkout into /config, except hidden ones and the folders install fills.
link() {
  local entry
  for entry in *; do
    if [[ ! -e $entry || $entry == custom_components || $entry == www ]]; then
      continue
    fi
    if [[ -L $config/$entry && $(readlink "$config/$entry") == "$current/$entry" ]]; then
      continue
    fi
    if [[ -e $config/$entry || -L $config/$entry ]]; then
      aside "$config/$entry"
    fi
    ln -s "$current/$entry" "$config/$entry"
    echo "Linked $entry"
  done
  for entry in "$config"/*; do
    if [[ -L $entry && $(readlink "$entry") == "$current/${entry##*/}" && ! -e ${entry##*/} ]]; then
      rm "$entry"
      echo "Removed the link ${entry##*/}"
    fi
  done
}

# The hash of the tree $1 in this commit, or nothing when the commit does not have it.
tree() {
  git rev-parse --verify --quiet "$commit:$1" || true
}

# Take ownership of $config/$1 and replace it with the folders of $1 if its marker does not match $2.
install() {
  local source=$1 target=$config/$1 want=$2 entry name
  if [[ ! -f $target/.git-sync ]]; then
    if [[ -e $target || -L $target ]]; then
      if [[ $source == custom_components ]]; then
        for entry in "$target"/*/; do
          if [[ -d $entry ]]; then
            record restart "$commit"
            break
          fi
        done
      fi
      aside "$target"
    fi
    mkdir "$target"
    : > "$target/.git-sync"
  fi
  if [[ $want == "$(cat "$target/.git-sync")" ]]; then
    return
  fi
  if [[ $source == custom_components ]]; then
    record restart "$commit"
    rm -f "$state/reloaded"
  fi
  write_atomic "$target/.git-sync" installing
  for entry in "$target"/* "$target"/.[!.]*; do
    name=${entry##*/}
    if [[ -e $entry && $name != .git-sync && ($name == .* || ! -d $source/$name) ]]; then
      rm -rf "$entry"
    fi
  done
  for entry in "$source"/*/; do
    [[ -d $entry ]] || continue
    name=${entry%/}
    name=${name##*/}
    cp -R "$source/$name" "$target/.$name.new"
    [[ -e $target/$name ]] && mv "$target/$name" "$target/.$name.old"
    mv "$target/.$name.new" "$target/$name"
    rm -rf "$target/.$name.old"
  done
  write_atomic "$target/.git-sync" "$want"
  echo "Installed $source from ${commit:0:7}"
}

# Install integrations and cards, retain one snapshot of the tree, and point current at it.
publish() {
  local commit=$1 content=$2 components=$3 cards=$4 snapshot name old
  if [[ $(readlink "$config/configuration.yaml" || true) != "$current/configuration.yaml" ]]; then
    for name in "${editor_files[@]}"; do
      if [[ -f $config/$name && ! -L $config/$name ]]; then
        aside "$config/$name"
      fi
    done
  fi
  if [[ -f $state/installed && $(head -n 1 "$state/installed") != "$commit" ]]; then
    mv "$state/installed" "$state/previous"
  fi
  [[ -d $config/www ]] || mkdir -m 2775 "$config/www"
  install custom_components "$components"
  install www/community "$cards"

  snapshot=$state/trees/$content
  if [[ ! -d $snapshot ]]; then
    rm -rf "$state/staging"
    mkdir "$state/staging"
    (
      GLOBIGNORE=.git
      cp -a --reflink=auto -- * "$state/staging/"
    )
    mv "$state/staging" "$snapshot"
  fi
  if [[ $(readlink "$config/$current" || true) != "state/trees/$content" ]]; then
    rm -f "$state/reloaded" "$state/applied"
  fi
  link
  ln -sfnT "state/trees/$content" "$state/.current"
  mv -Tf "$state/.current" "$config/$current"
  record installed "$commit" "$content" "$components" "$cards"
  rm -f "$state/previous"
  for old in "$state/trees"/*; do
    [[ $old == "$snapshot" ]] || rm -rf "$old"
  done
}

# Reload Home Assistant, or restart it when integrations changed, once it is running.
apply() {
  local ha status
  ha=$(api config)
  answered "$ha"
  [[ $ha == 200 ]] || die "Home Assistant answered HTTP $ha; retrying later"
  grep -q '"state": *"RUNNING"' "$state/response" || die "Home Assistant is still starting; retrying later"
  rm -f "$state/applied"
  if [[ -s $state/restart ]]; then
    status=$(api services/homeassistant/restart --data '{}')
    # Home Assistant may stop before it answers.
    [[ $status == closed ]] && status=200
    answered "$status"
    if [[ $status == 200 ]]; then
      echo "Restarting Home Assistant with ${built_from:0:7}, because integrations changed"
      rm "$state/restart"
    else
      notify restart "Home Assistant not restarted" "Home Assistant refused to restart with \
${built_from:0:7} (HTTP $status), so it keeps running the integrations it had, and the next deploy tries again. \
It checks the configuration with the integrations it runs, so if its answer is about an integration this deploy \
changed, restart Home Assistant yourself."$'\n\n'"$(excerpt)"
    fi
  else
    status=$(api services/homeassistant/reload_all --data '{}')
    answered "$status"
    if [[ $status == 200 ]]; then
      echo "Reloaded Home Assistant with ${built_from:0:7}"
    else
      notify reload "Configuration not reloaded" \
        "Reloading ${built_from:0:7} failed with HTTP $status: $(excerpt)"
    fi
  fi
  if [[ $status == 200 ]]; then
    record applied "$content"
  fi
}

built_from=$(git log -1 --format='%(trailers:key=Source-Commit,valueonly)' "$commit" | head -n 1)
if [[ -z $built_from ]]; then
  echo "${commit:0:7} has no Source-Commit trailer, so CI did not build it; not installing or reloading"
  if [[ $(recorded rejected) != "$commit" ]]; then
    notify deploy "Configuration not deployed" "The deployed branch is at ${commit:0:7}, which CI did not \
build, so nothing was installed or reloaded. The next CI run on the main branch restores it."
    record rejected "$commit"
  fi
  # An interrupted install can have changed live files. Restore the retained tree, even after git-sync prunes it.
  if [[ ! -f $state/installed && -f $state/previous ]]; then
    mapfile -t previous < "$state/previous"
    if ((${#previous[@]} == 4)); then
      (cd "$state/trees/${previous[1]}" && publish "${previous[@]}")
    fi
  fi
  send_notifications
  exit 0
fi

rm -f "$state/rejected"
content=$(git rev-parse "$commit^{tree}")
publish "$commit" "$content" "$(tree custom_components)" "$(tree www/community)"

if [[ $(recorded reloaded) != "$commit" && (-s $state/restart || $(recorded applied) != "$content") ]]; then
  apply
fi
record reloaded "$commit"

orphans=()
for name in "${editor_files[@]}"; do
  if [[ -f $config/$name && ! -L $config/$name ]]; then
    orphans+=("$name")
  fi
done
if ((${#orphans[@]})); then
  notify editor "Changes made in the UI are not loaded" "Home Assistant saved ${orphans[*]} in /config, \
but it loads its configuration from Git. Move the changes to the configuration repository and delete \
the files."
fi
send_notifications
